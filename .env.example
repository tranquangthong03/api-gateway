# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:dev@localhost:5432/ai_gateway
TEST_DATABASE_URL=postgres://postgres:dev@localhost:5432/ai_gateway_test
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# LLM providers (OpenAI-compatible endpoints, called through the openai SDK)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
DEFAULT_PROVIDER=gemini
FALLBACK_PROVIDER=groq

# Reliability
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=2
DEFAULT_RATE_LIMIT_PER_MIN=60
