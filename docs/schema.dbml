// AI Gateway — database schema (DBML for dbdiagram.io)
// v3 = owner's v2 + review fixes: no duplicate unique indexes, merged conversations index,
// no index on model_pricing.is_active. CHECKs / generated column: see docs/database.md.

Table users {
  id            uuid         [pk, default: `gen_random_uuid()`]
  email         varchar(255) [unique, not null]
  password_hash varchar(255) [not null, note: 'bcrypt']
  full_name     varchar(100) [null]
  role          varchar(20)  [not null, default: 'user', note: 'user | admin']
  is_active     boolean      [not null, default: true]
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]
}

Table api_keys {
  id                 uuid         [pk, default: `gen_random_uuid()`]
  user_id            uuid         [not null, ref: > users.id]
  name               varchar(100) [not null]
  key_hash           varchar(255) [unique, not null, note: 'SHA-256']
  key_prefix         varchar(12)  [not null]
  rate_limit_per_min int          [not null, default: 60]
  last_used_at       timestamptz  [null]
  expires_at         timestamptz  [null]
  revoked_at         timestamptz  [null]
  created_at         timestamptz  [not null, default: `now()`]
  indexes { (user_id, revoked_at) }
}

Table conversations {
  id            uuid         [pk, default: `gen_random_uuid()`]
  user_id       uuid         [not null, ref: > users.id]
  title         varchar(255) [null]
  default_model varchar(50)  [null, note: 'NULL = gateway default']
  system_prompt text         [null]
  is_archived   boolean      [not null, default: false]
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]
  indexes { (user_id, is_archived, updated_at) }
}

Table messages {
  id              uuid        [pk, default: `gen_random_uuid()`]
  conversation_id uuid        [not null, ref: > conversations.id]
  role            varchar(20) [not null, note: 'system | user | assistant']
  content         text        [not null]
  finish_reason   varchar(30) [null]
  created_at      timestamptz [not null, default: `clock_timestamp()`]
  indexes { (conversation_id, created_at) }
}

Table ai_requests {
  id              uuid          [pk, default: `gen_random_uuid()`]
  user_id         uuid          [not null, ref: > users.id]
  api_key_id      uuid          [null, ref: > api_keys.id]
  conversation_id uuid          [null, ref: > conversations.id]
  message_id      uuid          [null, unique, ref: - messages.id]
  request_id      varchar(64)   [not null, unique]
  endpoint        varchar(50)   [not null, note: 'chat | analyze']
  provider        varchar(50)   [not null]
  model           varchar(50)   [not null]
  is_fallback     boolean       [not null, default: false]
  is_cached       boolean       [not null, default: false]
  input_tokens    int           [not null, default: 0]
  output_tokens   int           [not null, default: 0]
  total_tokens    int           [note: 'GENERATED ALWAYS AS (input_tokens + output_tokens) STORED']
  cost_usd        numeric(10,6) [not null, default: 0]
  latency_ms      int           [not null]
  retry_count     int           [not null, default: 0]
  status          varchar(20)   [not null, note: 'success | error']
  error_code      varchar(50)   [null]
  error_message   text          [null]
  created_at      timestamptz   [not null, default: `now()`]
  indexes {
    (user_id, created_at)
    conversation_id
  }
}

Table model_pricing {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  provider            varchar(50)   [not null]
  model               varchar(50)   [not null]
  input_price_per_1k  numeric(10,6) [not null]
  output_price_per_1k numeric(10,6) [not null]
  effective_from      timestamptz   [not null, default: `now()`]
  is_active           boolean       [not null, default: true]
  indexes { (provider, model, effective_from) [unique] }
}
