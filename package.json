{
  "name": "ai-gateway",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "migrate": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate up",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"migrations/**/*.js\" \"*.js\" \"*.json\" \"*.yml\"",
    "docs:openapi": "node --env-file=.env src/openapi/generate.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "vitest": "5.0.2"
  }
}
