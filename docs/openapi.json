{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "AI Gateway API",
    "description": "Central AI Gateway backend service"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          }
        },
        "required": [
          "status",
          "db",
          "redis"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "nullable": true
              },
              "details": {
                "type": "object",
                "nullable": true,
                "additionalProperties": {
                  "nullable": true
                }
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Checks connectivity to PostgreSQL database and Redis cache.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is fully healthy",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "db": "ok",
                  "redis": "ok"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "db": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "redis": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "db",
                    "redis"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service is degraded or unhealthy (Database or Redis connection failed)",
            "content": {
              "application/json": {
                "example": {
                  "status": "error",
                  "db": "error",
                  "redis": "ok"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "db": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "redis": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "db",
                    "redis"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
