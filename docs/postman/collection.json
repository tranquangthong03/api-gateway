            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Contains service metadata', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql('ai-gateway');",
              "    pm.expect(jsonData.version).to.eql('1.0.0');",
              "    pm.expect(jsonData.docs).to.eql('/docs');",
              "    pm.expect(jsonData.health).to.eql('/health');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
